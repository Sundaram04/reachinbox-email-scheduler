# Copy this file to .env and fill real values. Never commit .env

NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://reachinbox:reachinbox@localhost:5433/reachinbox
DB_POOL_MAX=10
REDIS_URL=redis://localhost:6380

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
JWT_SECRET=change-me-to-a-secret-at-least-32-chars-long
AUTH_SUCCESS_REDIRECT=http://localhost:4000/api/me